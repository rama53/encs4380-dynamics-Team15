<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Module 4: Guess the sensor</title>
<style>
:root{
  --bg:#f5f7fa;--card:#fff;--ink:#18232f;--muted:#5d6b7a;--line:#dfe5ec;
  --curve:#1d5fa8;--mark:#d4561f;--mark2:#14806a;--okbg:#dff3ec;--badbg:#fbe3dc;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){color-scheme:dark;--bg:#10161d;--card:#18212b;--ink:#e8eef4;--muted:#9aa9b8;--line:#2b3745;--curve:#6cb0f0;--mark:#ff8a5c;--mark2:#4fd0b0;--okbg:#14382f;--badbg:#4a2219}
}
:root[data-theme="dark"]{color-scheme:dark;--bg:#10161d;--card:#18212b;--ink:#e8eef4;--muted:#9aa9b8;--line:#2b3745;--curve:#6cb0f0;--mark:#ff8a5c;--mark2:#4fd0b0;--okbg:#14382f;--badbg:#4a2219}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--ink);font-family:system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;line-height:1.5;padding:20px 16px 48px}
main{max-width:860px;margin:0 auto}
h1{font-size:clamp(22px,4vw,30px);margin:8px 0 4px}
h2{font-size:18px;margin:0 0 4px}
.sub{color:var(--muted);margin:0 0 20px;max-width:70ch}
.panel{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:18px;margin-top:16px}
.desc{color:var(--muted);margin:0 0 8px;max-width:70ch}
.score{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}
.score div{background:var(--card);border:1px solid var(--line);border-top:4px solid var(--curve);border-radius:12px;padding:14px}
.score span{display:block;font-size:14px;color:var(--muted)}
.score b{display:block;font-size:24px;font-variant-numeric:tabular-nums;color:var(--curve)}
canvas{display:block;width:100%;height:340px;touch-action:pan-y}
.legend{display:flex;flex-wrap:wrap;gap:6px 20px;padding:4px 2px;color:var(--muted);font-size:14px}
.legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px}
#readout{color:var(--muted);font-size:14px;margin:4px 2px 0;min-height:1.5em;font-variant-numeric:tabular-nums}
.fields{display:grid;grid-template-columns:1fr 1fr;gap:16px 28px;margin:14px 0}
.fields label{display:block;font-weight:600;margin-bottom:6px}
.fields input{font:inherit;width:100%;padding:9px 12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--ink);font-variant-numeric:tabular-nums}
.fields small{display:block;color:var(--muted);margin-top:4px}
.row{display:flex;flex-wrap:wrap;gap:10px}
.go{font:inherit;font-weight:600;padding:9px 18px;border:0;border-radius:10px;background:var(--curve);color:#fff;cursor:pointer}
.go[disabled]{opacity:.5;cursor:not-allowed}
.sec{font:inherit;font-weight:600;padding:9px 18px;border:1px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);cursor:pointer}
.sec[disabled]{opacity:.5;cursor:not-allowed}
button:focus-visible,input:focus-visible{outline:3px solid var(--mark);outline-offset:2px}
#hint{margin:12px 0 0;padding:12px;border:1px dashed var(--line);border-radius:10px;color:var(--ink)}
#msg{margin:12px 0 0;font-weight:600;min-height:1.5em}
.wrap{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:520px}
th,td{text-align:left;padding:10px 8px;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums}
th{color:var(--muted);font-size:14px}
.pill{display:inline-block;padding:2px 12px;border-radius:99px;font-weight:700}
.pass{background:var(--okbg);color:var(--mark2)}.fail{background:var(--badbg);color:var(--mark)}
#big{font-size:20px;font-weight:700;margin:0 0 8px}
@media(max-width:480px){.fields{grid-template-columns:1fr}canvas{height:290px}.score b{font-size:20px}}
</style>
<link rel="stylesheet" href="../assets/site.css">
</head>
<body>
<nav class="site-nav" aria-label="Main navigation"><a href="../">Home</a><a href="../module1/">Module 1</a><a href="../module2/">Module 2</a><a href="../module3/">Module 3</a><a href="../module4/" aria-current="page">Module 4</a></nav>
<main>
  <h1>Module 4: Guess the sensor</h1>
  <p class="sub">A hidden sensor produced the noisy points below. Read the curve, work backwards, and estimate its parameters using the methods from Modules 1 to 3. Within 10% of the true value is full marks.</p>
 
  <section class="score" aria-live="polite" aria-label="Session score">
    <div><span>Rounds played</span><b id="sRounds">0</b></div>
    <div><span>Total score</span><b id="sTotal">0</b></div>
    <div><span>Average per round</span><b id="sAvg">–</b></div>
  </section>
 
  <div class="panel">
    <h2 id="title"></h2>
    <p class="desc" id="info"></p>
    <canvas id="plot" role="img" aria-label="Noisy response of a hidden sensor versus time"></canvas>
    <div class="legend" id="lg"></div>
    <p id="readout">Move the pointer over the plot to read t and y.</p>
  </div>
 
  <div class="panel">
    <h2>Your estimate</h2>
    <p class="desc" id="what"></p>
    <div class="fields">
      <div><label for="g1" id="l1"></label><input id="g1" type="number" step="0.01" inputmode="decimal"><small id="s1"></small></div>
      <div><label for="g2" id="l2"></label><input id="g2" type="number" step="0.01" inputmode="decimal"><small id="s2"></small></div>
    </div>
    <div class="row">
      <button class="go" id="bSub">Submit my guess</button>
      <button class="sec" id="bHint">Show a hint</button>
      <button class="sec" id="bNew">New sensor</button>
    </div>
    <p id="msg" aria-live="polite"></p>
    <p id="hint" hidden></p>
  </div>
 
  <div class="panel" id="rev" hidden>
    <p id="big"></p>
    <p class="desc">The solid curve is the true sensor, the dashed curve is your guess.</p>
    <div class="wrap"><table>
      <thead><tr><th>Parameter</th><th>True value</th><th>Your guess</th><th>Error</th><th>Result</th></tr></thead>
      <tbody id="rbody"></tbody>
    </table></div>
  </div>
</main>
 
<script>
const $ = id => document.getElementById(id);
const FF = "system-ui, Arial, sans-serif";
let S = null, C = {}, G = null, rounds = 0, total = 0, hintLvl = 0, revealed = false, guess = null;
 
const rnd = (a,b) => a + Math.random()*(b-a);
const r2 = x => Math.round(x*100)/100;
const css = n => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
function gauss(){ let u=0,v=0; while(!u) u=Math.random(); v=Math.random(); return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v); }
function niceCeil(x){
  const p = Math.pow(10, Math.floor(Math.log10(x)));
  for(const m of [1,2,2.5,5,10]) if(m*p >= x - 1e-12) return m*p;
  return 10*p;
}
 
/* Closed-form responses from the slides */
const first = (K,tau) => t => K*(1 - Math.exp(-t/tau));
const firstSine = (K,tau,w) => t => K*(w*tau*Math.exp(-t/tau) + Math.sin(w*t) - w*tau*Math.cos(w*t))/(1 + w*w*tau*tau);
const second = (z,wn) => t => {
  const wd = wn*Math.sqrt(1-z*z);
  return 1 - Math.exp(-z*wn*t)*(Math.cos(wd*t) + z/Math.sqrt(1-z*z)*Math.sin(wd*t));
};
 
function newSensor(){
  const kind = Math.random() < 0.5 ? "first" : "second";
  let s;
  if(kind === "first"){
    const sine = Math.random() < 0.35;
    const K = r2(rnd(0.5,4)), tau = r2(rnd(sine?0.3:0.5, sine?3:6)), w = sine ? r2(rnd(0.5,2)) : 0;
    const tmax = sine ? niceCeil(Math.max(4*2*Math.PI/w, 5*tau)) : niceCeil(6*tau);
    s = {kind, sine, K, tau, w, tmax, f: sine ? firstSine(K,tau,w) : first(K,tau),
         p:[{n:"Gain K",v:K,u:""},{n:"Time constant τ",v:tau,u:" s"}]};
  } else {
    const z = r2(rnd(0.1,0.9)), wn = r2(rnd(1,8));
    s = {kind, sine:false, z, wn, tmax: niceCeil(Math.min(6/(z*wn), 40)), f: second(z,wn),
         p:[{n:"Damping ratio ζ",v:z,u:""},{n:"Natural frequency ωn",v:wn,u:" rad/s"}]};
  }
  let peak = 0; const N = 400;
  for(let i=0;i<=N;i++) peak = Math.max(peak, Math.abs(s.f(i/N*s.tmax)));
  s.sigma = 0.03*peak;
  s.data = [];
  for(let i=0;i<=70;i++){ const t = i/70*s.tmax; s.data.push([t, s.f(t) + s.sigma*gauss()]); }
  return s;
}
 
function startRound(){
  S = newSensor(); revealed = false; guess = null; hintLvl = 0;
  $("rev").hidden = true; $("msg").textContent = ""; $("hint").hidden = true;
  $("bSub").disabled = false; $("bHint").disabled = false; $("bHint").textContent = "Show a hint";
  $("g1").value = ""; $("g2").value = "";
  if(S.kind === "first"){
    $("title").textContent = S.sine ? "Sensor response to a sine input" : "Sensor response to a unit step";
    $("info").textContent = S.sine
      ? "First-order sensor. Input: sin(" + S.w + "·t), shown dashed. The dots are the noisy output."
      : "First-order sensor. Input: a unit step (A = 1) at t = 0. The dots are the noisy output.";
    $("what").textContent = "Estimate the gain K and the time constant τ.";
    $("l1").textContent = "Gain K"; $("s1").textContent = "No unit";
    $("l2").textContent = "Time constant τ (s)"; $("s2").textContent = "Seconds";
  } else {
    $("title").textContent = "Sensor response to a unit step";
    $("info").textContent = "Second-order sensor with DC gain 1. Input: a unit step at t = 0. The dots are the noisy output.";
    $("what").textContent = "Estimate the damping ratio ζ and the natural frequency ωn.";
    $("l1").textContent = "Damping ratio ζ"; $("s1").textContent = "Between 0 and 1";
    $("l2").textContent = "Natural frequency ωn (rad/s)"; $("s2").textContent = "Radians per second";
  }
  draw();
}
 
function setup(cv){
  const w = cv.clientWidth, h = cv.clientHeight, r = window.devicePixelRatio || 1;
  cv.width = Math.round(w*r); cv.height = Math.round(h*r);
  const c = cv.getContext("2d"); c.setTransform(r,0,0,r,0,0); c.clearRect(0,0,w,h);
  return {c,w,h};
}
function strokeFn(c,g,f,col,dash){
  c.strokeStyle = col; c.lineWidth = 3; c.setLineDash(dash || []); c.beginPath();
  for(let i=0;i<=600;i++){ const t = i/600*g.tmax, y = f(t); i ? c.lineTo(g.px(t),g.py(y)) : c.moveTo(g.px(t),g.py(y)); }
  c.stroke(); c.setLineDash([]);
}
 
function draw(){
  if(!S) return;
  C = {line:css("--line"),muted:css("--muted"),ink:css("--ink"),curve:css("--curve"),m1:css("--mark"),m2:css("--mark2")};
  const {c,w,h} = setup($("plot"));
  const gf = revealed ? guessFn() : null;
  let lo = 0, hi = 0;
  S.data.forEach(d => { lo = Math.min(lo,d[1]); hi = Math.max(hi,d[1]); });
  if(S.sine) { lo = Math.min(lo,-1); hi = Math.max(hi,1); }
  const pad = (hi-lo)*0.1, ymin = lo - (lo<0?pad:0), ymax = hi + pad;
  const L=52,R=16,T=18,B=46,pw=w-L-R,ph=h-T-B;
  const g = {L,T,pw,ph,w,h,ymin,ymax,tmax:S.tmax,px:t=>L+t/S.tmax*pw,py:v=>T+(ymax-v)/(ymax-ymin)*ph};
  G = g;
  c.font = "12px "+FF; c.lineWidth = 1;
  for(let i=0;i<=4;i++){
    const t = i*S.tmax/4;
    c.strokeStyle=C.line; c.beginPath(); c.moveTo(g.px(t),T); c.lineTo(g.px(t),T+ph); c.stroke();
    c.fillStyle=C.muted; c.textAlign="center"; c.fillText(+t.toFixed(2),g.px(t),T+ph+16);
  }
  const step = niceCeil((ymax-ymin)/5);
  for(let v=Math.ceil(ymin/step)*step; v<=ymax+1e-9; v+=step){
    c.strokeStyle=C.line; c.beginPath(); c.moveTo(L,g.py(v)); c.lineTo(L+pw,g.py(v)); c.stroke();
    c.fillStyle=C.muted; c.textAlign="right"; c.fillText(+v.toFixed(2),L-8,g.py(v)+4);
  }
  c.fillStyle=C.ink; c.textAlign="center"; c.fillText("Time (s)",L+pw/2,T+ph+36);
  c.save(); c.translate(12,T+ph/2); c.rotate(-Math.PI/2); c.fillText("Output y(t)",0,0); c.restore();
  if(S.sine) strokeFn(c,g,t=>Math.sin(S.w*t),C.muted,[6,5]);
  if(revealed){
    strokeFn(c,g,S.f,C.m2);
    strokeFn(c,g,gf,C.m1,[8,6]);
  }
  c.fillStyle = C.curve;
  S.data.forEach(d => { c.beginPath(); c.arc(g.px(d[0]),g.py(d[1]),3.5,0,7); c.fill(); });
  $("lg").innerHTML = '<span><i style="background:var(--curve)"></i>Noisy measurements</span>'
    + (S.sine ? '<span><i style="background:var(--muted)"></i>Input sin(ωt), dashed</span>' : '')
    + (revealed ? '<span><i style="background:var(--mark2)"></i>True sensor</span><span><i style="background:var(--mark)"></i>Your guess, dashed</span>' : '');
}
 
function guessFn(){
  if(S.kind === "first") return S.sine ? firstSine(guess[0],guess[1],S.w) : first(guess[0],guess[1]);
  return second(Math.min(Math.max(guess[0],0.001),0.999), guess[1]);
}
 
function submit(){
  const a = parseFloat($("g1").value), b = parseFloat($("g2").value);
  if(!(a>0) || !(b>0)){ $("msg").textContent = "Enter a positive number in both boxes first."; return; }
  if(S.kind === "second" && a >= 1){ $("msg").textContent = "This sensor is underdamped, so ζ must be below 1."; return; }
  guess = [a,b]; revealed = true;
  const truth = S.p.map(p => p.v);
  let sum = 0;
  $("rbody").innerHTML = S.p.map((p,i)=>{
    const err = Math.abs(guess[i]-truth[i])/truth[i];
    const pts = err <= 0.1 ? 1 : Math.max(0, 1-(err-0.1)/0.4);
    sum += pts;
    return `<tr><td>${p.n}</td><td>${truth[i].toFixed(2)}${p.u}</td><td>${guess[i].toFixed(2)}${p.u}</td><td>${(err*100).toFixed(1)}%</td><td><span class="pill ${err<=0.1?"pass":"fail"}">${err<=0.1?"Within 10%":"Off"}</span></td></tr>`;
  }).join("");
  const score = Math.round(sum/2*100);
  rounds++; total += score;
  $("big").textContent = "Round score: " + score + " / 100" + (score===100 ? " (full marks)" : "");
  $("rev").hidden = false; $("msg").textContent = "";
  $("bSub").disabled = true; $("bHint").disabled = true;
  $("sRounds").textContent = rounds; $("sTotal").textContent = total; $("sAvg").textContent = Math.round(total/rounds);
  draw();
  $("rev").scrollIntoView({behavior:"smooth",block:"nearest"});
}
 
function hint(){
  const H = S.kind === "second" ? [
    "Overshoot depends only on ζ. Read the peak height, find Mp = (peak − 1)/1, then solve ζ.",
    "ζ = −ln(Mp) / √(π² + ln²(Mp)). Then read the peak time tp and use ωn = π / (tp·√(1−ζ²))."
  ] : S.sine ? [
    "In steady state the output is a sine at the same frequency, scaled by K/√(1+(ωτ)²) and delayed in time.",
    "Measure the time delay Δt between input and output peaks. The phase lag is φ = ω·Δt = tan⁻¹(ωτ), so τ = tan(φ)/ω. Then use the amplitude to find K."
  ] : [
    "The final value of a unit step is K. Estimate it from where the dots level off.",
    "Find the time where the output reaches 63.2% of the final value: that time is τ. Or plot ln(1 − y/K) against t and use the slope −1/τ."
  ];
  const h = H[Math.min(hintLvl,1)];
  hintLvl++;
  $("hint").hidden = false; $("hint").textContent = "Hint " + Math.min(hintLvl,2) + ": " + h;
  $("bHint").textContent = hintLvl >= 2 ? "Hint shown" : "Show more help";
}
 
function pointer(e){
  if(!G) return;
  const r = $("plot").getBoundingClientRect(), x = e.clientX - r.left, y = e.clientY - r.top;
  if(x < G.L || x > G.L+G.pw || y < G.T || y > G.T+G.ph){ return; }
  const t = (x-G.L)/G.pw*G.tmax, v = G.ymax - (y-G.T)/G.ph*(G.ymax-G.ymin);
  $("readout").textContent = "t = " + t.toFixed(2) + " s, y = " + v.toFixed(3);
}
 
$("bSub").addEventListener("click",submit);
$("bHint").addEventListener("click",hint);
$("bNew").addEventListener("click",startRound);
$("plot").addEventListener("pointermove",pointer);
window.addEventListener("resize",draw);
matchMedia("(prefers-color-scheme: dark)").addEventListener("change",draw);
startRound();
</script>
</body>
</html>
